# Course Slides Manager - Environment Variables
# Copy this file to .env.local for local development

# Application
NEXT_PUBLIC_APP_NAME="Course Slides Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: For future cloud storage integration
# NEXT_PUBLIC_STORAGE_BUCKET=your-bucket-name
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key

# Optional: For future authentication
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here

# Optional: Analytics (for future use)
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
