# Course Slides Manager - Environment Variables
# Copy this file to .env.local for local development

# Application
NEXT_PUBLIC_APP_NAME="Course Slides Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Configuration (Required for cloud storage)
# Get these from Firebase Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: For future authentication
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here

# Optional: Analytics (for future use)
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
